  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "About the Game : \nRun as far as you can, dodge dangerous obstacles, overcome
    challenging traps, and test your reflexes in a thrilling endless-running adventure!\nYour
    runner starts at a low speed, but gradually gets faster as you progress. Stay
    focused, react quickly, solve puzzles, and try to achieve the highest score.
    Challenge your friends to beat your high score.\n\nHOW TO PLAY : \nMove Left
    or Right - Swipe left or right on the screen to move sideways.Tilt your mobile
    device left or right to steer your runner.\nJump - Swipe upward on the screen
    to jump over obstacles and avoid dangers.\n\nSOLVE THE TRAPS :\nSome traps require
    you to solve puzzles before you can safely pass. Solve them correctly to disable
    the trap and continue your run!\n1. Math Puzzle\nSolve the displayed mathematical
    question and select the correct answer.\n2. Color Sequence Puzzle\nRemember the
    displayed sequence of three colors, then tap the corresponding color buttons
    in exactly the same order.\n3. Wire Connection Puzzle\nConnect the wires by matching
    the correct colors to complete the circuit.\n\nStay alert, trust your reflexes,
    solve the puzzles, and keep running. How far can you go?\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 706c317ec7fb39749a47365e92b6389f, type: 2}
  m_sharedMaterial: {fileID: 7940248536365578108, guid: 706c317ec7fb39749a47365e92b6389f, type: 2}
